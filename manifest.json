
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#1769e0">
<title>PDF Editor</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f4f9;color:#172033}
header{background:#1769e0;color:white;padding:18px;display:flex;align-items:center;justify-content:space-between}
header h1{font-size:20px;margin:0}
main{max-width:850px;margin:auto;padding:16px}
button{border:0;border-radius:10px;padding:13px 16px;font-size:15px;font-weight:600;cursor:pointer}
button:disabled{opacity:.4}
.primary{background:#1769e0;color:white}
.secondary{background:white;color:#1769e0;border:1px solid #dce3ed}
.danger{background:#ffe8e8;color:#c62828}
#welcome{text-align:center;background:white;padding:40px 20px;border-radius:18px;margin-top:35px}
.symbol{font-size:60px}
#welcome p{color:#687386;line-height:1.5}
#editor,#finish{display:none}
.file-info,.panel{background:white;padding:16px;border-radius:14px;margin-bottom:14px;overflow-wrap:anywhere}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.toolbar button{flex:1;min-width:90px}
.viewer{background:#dce2eb;border-radius:14px;min-height:300px;padding:14px;display:flex;align-items:center;justify-content:center;overflow:auto}
canvas{display:block;max-width:100%;height:auto;background:white;box-shadow:0 3px 15px #0002}
.navigation{display:flex;justify-content:center;align-items:center;gap:15px;margin:16px 0}
.navigation span{font-weight:bold}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
#status{color:#657084;font-size:13px;text-align:center;margin-top:18px;min-height:20px}
#fileInput{display:none}
input[type=text]{width:100%;padding:15px;border:1px solid #ccd5e2;border-radius:10px;font-size:16px;margin:12px 0 18px}
.finish-actions{display:grid;gap:10px}
.finish-icon{font-size:48px;text-align:center}
footer{text-align:center;padding:25px;color:#8992a1;font-size:12px}
</style>
</head>
<body>
<header>
<h1>📄 PDF Editor</h1>
<button class="secondary" id="openBtn">Abrir PDF</button>
</header>

<main>
<section id="welcome">
<div class="symbol">📑</div>
<h2>Seu PDF, do seu jeito.</h2>
<p>Visualize, organize e edite seus documentos facilmente.</p>
<button class="primary" id="welcomeOpen">Escolher arquivo PDF</button>
</section>

<section id="editor">
<div class="file-info">
<strong id="fileName">Documento.pdf</strong>
<div id="fileDetails"></div>
</div>

<div class="toolbar">
<button class="secondary" id="zoomOut">− Zoom</button>
<button class="secondary" id="zoomIn">+ Zoom</button>
<button class="secondary" id="rotateBtn">↻ Girar</button>
</div>

<div class="viewer"><canvas id="pdfCanvas"></canvas></div>

<div class="navigation">
<button class="secondary" id="prevBtn">← Anterior</button>
<span id="pageLabel">1 / 1</span>
<button class="secondary" id="nextBtn">Próxima →</button>
</div>

<div class="actions">
<button class="danger" id="deleteBtn">🗑️ Excluir esta página</button>
<button class="secondary" id="undoBtn" disabled>↶ Desfazer</button>
<button class="primary" id="doneBtn" style="grid-column:1/-1">✓ Pronto</button>
</div>
</section>

<section id="finish">
<div class="panel">
<div class="finish-icon">📄</div>
<h2 style="text-align:center">Seu PDF está pronto!</h2>
<p>Escolha o nome do documento:</p>
<input type="text" id="outputName" placeholder="Meu documento" maxlength="100">
<div class="finish-actions">
<button class="primary" id="shareBtn">📤 Compartilhar PDF</button>
<button class="secondary" id="downloadBtn">💾 Salvar no dispositivo</button>
<button class="secondary" id="backBtn">← Voltar ao editor</button>
</div>
</div>
</section>

<div id="status">Pronto para abrir um documento.</div>
</main>

<footer>PDF Editor · Simples e fácil de usar</footer>
<input type="file" id="fileInput" accept=".pdf,application/pdf">

<script>
pdfjsLib.GlobalWorkerOptions.workerSrc=
"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

const $=id=>document.getElementById(id);
const fileInput=$("fileInput");
const canvas=$("pdfCanvas");
const ctx=canvas.getContext("2d");

let originalBytes=null;
let pdfDoc=null;
let fileName="documento.pdf";
let pages=[];
let deletedPages=[];
let rotations={};
let currentPage=0;
let zoom=1;
let rendering=false;
let finalBlob=null;

function status(message){$("status").textContent=message}
function showScreen(screen){
$("welcome").style.display=screen==="welcome"?"block":"none";
$("editor").style.display=screen==="editor"?"block":"none";
$("finish").style.display=screen==="finish"?"block":"none";
}

$("openBtn").onclick=()=>$("fileInput").click();
$("welcomeOpen").onclick=()=>$("fileInput").click();

fileInput.onchange=async()=>{
const file=fileInput.files[0];
fileInput.value="";
if(!file)return;

if(file.type!=="application/pdf"&&!file.name.toLowerCase().endsWith(".pdf")){
status("Escolha um arquivo PDF válido.");
return;
}

try{
status("Abrindo documento...");
originalBytes=new Uint8Array(await file.arrayBuffer());
pdfDoc=await pdfjsLib.getDocument({data:originalBytes.slice()}).promise;
fileName=file.name;
pages=Array.from({length:pdfDoc.numPages},(_,i)=>i+1);
deletedPages=[];
rotations={};
currentPage=0;
zoom=1;
finalBlob=null;
$("fileName").textContent=fileName;
showScreen("editor");
await renderPage();
status("Documento aberto!");
}catch(error){status("Erro ao abrir PDF: "+error.message)}
};

async function renderPage(){
if(!pdfDoc||rendering||!pages.length)return;
rendering=true;
try{
currentPage=Math.max(0,Math.min(currentPage,pages.length-1));
const number=pages[currentPage];
const page=await pdfDoc.getPage(number);
const rotation=(page.rotate+(rotations[number]||0))%360;
const base=page.getViewport({scale:1,rotation});
const available=Math.max(250,$("editor").clientWidth-35);
const scale=Math.min(1.7,available/base.width)*zoom;
const viewport=page.getViewport({scale,rotation});
canvas.width=Math.floor(viewport.width);
canvas.height=Math.floor(viewport.height);
await page.render({canvasContext:ctx,viewport}).promise;
$("pageLabel").textContent=(currentPage+1)+" / "+pages.length;
$("fileDetails").textContent=pages.length+" páginas";
$("prevBtn").disabled=currentPage===0;
$("nextBtn").disabled=currentPage===pages.length-1;
$("undoBtn").disabled=deletedPages.length===0;
}catch(error){status("Erro ao visualizar página.")}
finally{rendering=false}
}

$("prevBtn").onclick=async()=>{
if(currentPage>0){currentPage--;await renderPage()}
};
$("nextBtn").onclick=async()=>{
if(currentPage<pages.length-1){currentPage++;await renderPage()}
};
$("zoomIn").onclick=async()=>{zoom=Math.min(2.5,zoom+.2);await renderPage()};
$("zoomOut").onclick=async()=>{zoom=Math.max(.5,zoom-.2);await renderPage()};

$("rotateBtn").onclick=async()=>{
if(!pages.length)return;
const number=pages[currentPage];
rotations[number]=((rotations[number]||0)+90)%360;
await renderPage();
status("Rotação aplicada.");
};

$("deleteBtn").onclick=async()=>{
if(pages.length<=1){status("O PDF precisa ter pelo menos uma página.");return}
if(!confirm("Deseja realmente excluir esta página?"))return;
const removed=pages.splice(currentPage,1)[0];
deletedPages.push({number:removed,position:currentPage});
if(currentPage>=pages.length)currentPage=pages.length-1;
await renderPage();
status("Página excluída.");
};

$("undoBtn").onclick=async()=>{
if(!deletedPages.length)return;
const last=deletedPages.pop();
pages.splice(last.position,0,last.number);
currentPage=last.position;
await renderPage();
status("Exclusão desfeita.");
};

async function buildPdf(){
if(!originalBytes||!pages.length)throw new Error("Nenhuma página disponível.");
const {PDFDocument,degrees}=PDFLib;
const output=await PDFDocument.load(originalBytes);
const keep=new Set(pages);

for(let i=output.getPageCount()-1;i>=0;i--){
if(!keep.has(i+1))output.removePage(i);
}

const outputPages=output.getPages();
pages.forEach((number,index)=>{
const rotation=rotations[number]||0;
if(rotation){
const page=outputPages[index];
page.setRotation(degrees((page.getRotation().angle+rotation)%360));
}
});

const bytes=await output.save();
return new Blob([bytes],{type:"application/pdf"});
}

$("doneBtn").onclick=async()=>{
try{
status("Preparando seu PDF...");
finalBlob=await buildPdf();
const suggested=fileName.replace(/\.pdf$/i,"")+"-editado";
$("outputName").value=suggested;
showScreen("finish");
status("Documento pronto!");
}catch(error){status("Erro ao preparar PDF: "+error.message)}
};

function getOutputName(){
let name=$("outputName").value.trim()||"documento";
name=name.replace(/[\\/:*?"<>|]/g,"-");
if(!name.toLowerCase().endsWith(".pdf"))name+=".pdf";
return name;
}

$("downloadBtn").onclick=()=>{
if(!finalBlob)return;
const url=URL.createObjectURL(finalBlob);
const link=document.createElement("a");
link.href=url;
link.download=getOutputName();
document.body.appendChild(link);
link.click();
link.remove();
setTimeout(()=>URL.revokeObjectURL(url),3000);
status("Download iniciado!");
};

$("shareBtn").onclick=async()=>{
if(!finalBlob)return;
const name=getOutputName();
const file=new File([finalBlob],name,{type:"application/pdf"});

try{
if(navigator.canShare&&navigator.canShare({files:[file]})){
await navigator.share({
files:[file],
title:name,
text:"PDF editado"
});
status("Compartilhamento concluído.");
}else{
$("downloadBtn").click();
status("Seu navegador não permite compartilhar arquivos diretamente. O PDF foi baixado para você compartilhar.");
}
}catch(error){
if(error.name!=="AbortError")status("Não foi possível compartilhar: "+error.message);
}
};

$("backBtn").onclick=()=>showScreen("editor");
</script>
</body>
</html>
